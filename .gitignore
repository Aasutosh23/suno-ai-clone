# ============================================================
#  Suno AI Clone — Root .gitignore
# ============================================================

# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
# Keep frontend source files trackable despite the Python lib rule.
!frontend/src/lib/
!frontend/src/lib/**
*.manifest
*.spec

# Virtual environments
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# mypy / type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Modal / cloud artifacts
.modal.toml

# Generated audio / media files
*.wav
*.mp3
*.ogg
*.flac
*.aac
*.mp4
*.avi

# Model weights & large binary files
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.h5

# Large wheel files
*.whl

# ──────────────────────────────────────────────
# Node.js / Frontend
# ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
frontend/.next/
frontend/out/

# Prisma generated client
frontend/generated/

# Production build
frontend/build/

# TypeScript incremental build
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────
# Environment & Secrets — NEVER commit these!
# ──────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ──────────────────────────────────────────────
# OS / Editor
# ──────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains IDEs
.idea/
*.iml

# ──────────────────────────────────────────────
# Logs & temporary files
# ──────────────────────────────────────────────
logs/
*.log
tmp/
temp/
.tmp/
.cache/

# ──────────────────────────────────────────────
# AWS / Cloud credentials
# ──────────────────────────────────────────────
.aws/
credentials
